{
  "name": "@wsl/standard-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && node --import tsx --test tests/*.test.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "db:migrate": "node --import tsx server/db-cli.ts migrate",
    "db:seed": "node --import tsx server/db-cli.ts seed",
    "template:hash": "node scripts/template-hash.mjs",
    "template:verify": "node scripts/template-hash.mjs --verify"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
