+  if (snapshot?.catalog) {
+    return {
+      ...createResourceCatalog(snapshot.catalog.accountId),
+      revision: snapshot.catalog.revision,
+      resources: snapshot.catalog.resources.map(({ latestVersion: _latestVersion, versions: _versions, ...resource }) => resource),
