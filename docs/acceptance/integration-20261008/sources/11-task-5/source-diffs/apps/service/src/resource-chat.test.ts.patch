+describe('live observation dispatch (protocol harness, no model)', () => {
+  it('drops observation results after cancellation without returning them to the model', async () => {
+    const f = fixture();
+    let resolve!: (value: { error: 'not_found'; message: string }) => void;
+    f.chat.setObservationReader(
+      () =>
+        new Promise((r) => {
+          resolve = r;
+        }),
+    );
+    await f.chat.send(space, 'read');
+    f.frame({ type: 'observation-call', id: 'late', tool: 'files.read', args: { path: 'x' } });
+    await f.chat.cancel(space);
+    resolve({ error: 'not_found', message: 'late observation' });
+    await new Promise((r) => setTimeout(r, 0));
+    expect(f.write).not.toHaveBeenCalled();
+    await f.chat.shutdown();
+  });
+
+  it('binds workspace on host and returns the real reader result into guest transport', async () => {
+    const f = fixture();
+    const reader = vi.fn(async () => ({ error: 'not_found' as const, message: 'actual provider result' }));
+    f.chat.setObservationReader(reader);
+    await f.chat.send(space, 'read current page');
+    expect(f.start.mock.calls[0]?.[0]).toMatchObject({ observation: true });
+    f.frame({ type: 'observation-call', id: 'call-1', tool: 'files.read', args: { path: 'missing.txt' } });
+    await vi.waitFor(() =>
+      expect(f.write).toHaveBeenCalledWith({
+        type: 'observation-result',
+        id: 'call-1',
+        result: { error: 'not_found', message: 'actual provider result' },
+      }),
+    );
+    expect(reader).toHaveBeenCalledWith({ workspaceId: 'taskflow-demo', tool: 'files.read', args: { path: 'missing.txt' } });
+    f.finish();
+    await f.chat.shutdown();
+  });
+  it('rejects personal scope and arbitrary execution tools without dispatching a provider', async () => {
+    const f = fixture();
+    const reader = vi.fn();
+    f.chat.setObservationReader(reader);
+    await f.chat.send(personal, 'read');
+    expect(f.start.mock.calls[0]?.[0]).toMatchObject({ observation: false });
+    f.frame({ type: 'observation-call', id: 'call-2', tool: 'browser.evaluate', args: { code: 'bad' } });
+    await vi.waitFor(() =>
+      expect(f.write).toHaveBeenCalledWith(expect.objectContaining({ result: expect.objectContaining({ error: 'unauthorized' }) })),
+    );
+    expect(reader).not.toHaveBeenCalled();
+    f.finish();
+    await f.chat.shutdown();
+  });
+});
