@@ -0,0 +1,92 @@
+import { execFileSync } from 'node:child_process';
+import { expect, it } from 'vitest';
+import path from 'node:path';
+
+it.each([false, true])('uses a real Unix socket with image capability %s and preserves observation metadata', (images) => {
+  const script = `
+import importlib.util, socket, tempfile, threading, json, os
+spec = importlib.util.spec_from_file_location('observation_mcp', ${JSON.stringify(path.resolve('apps/service/src/resource_mcp.py'))})
+m = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(m)
+m.OBSERVATION_IMAGES = ${images ? 'True' : 'False'}
+png = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+aXioAAAAASUVORK5CYII='
+with tempfile.TemporaryDirectory(prefix='wsl-mcp-') as root:
+    m.OBSERVATION_SOCKET = root + '/read.sock'
+    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    server.bind(m.OBSERVATION_SOCKET)
+    server.listen(1)
+    calls = []
+    def reply():
+        client, _ = server.accept()
+        with client:
+            request = json.loads(client.makefile('rb').readline())
+            calls.append(request)
+            client.sendall((json.dumps({'resource': {'resourceId': 'real-instance'}, 'coverage': {'status': 'partial'}, 'data': {'dataUrl': 'data:image/png;base64,' + png, 'base64': 'invalid-image'}, 'evidenceRef': 'sha256:fixed'}) + '\\n').encode())
+    worker = threading.Thread(target=reply)
+    worker.start()
+    result = m.dispatch({}, 'tools/call', {'name': 'browser_snapshot', 'arguments': {'resourceId': 'real-instance'}})
+    worker.join(timeout=2)
+    assert calls == [{'tool': 'browser.snapshot', 'args': {'resourceId': 'real-instance'}}]
+    assert result['structuredContent']['data']['evidenceRef'] == 'sha256:fixed'
+    assert 'data:image' not in json.dumps(result)
+    assert png not in json.dumps(result['structuredContent'])
+    if m.OBSERVATION_IMAGES:
+        assert len(result['content']) == 2
+        assert result['content'][1] == {'type': 'image', 'mimeType': 'image/png', 'data': png}
+        assert result['structuredContent']['data']['data']['base64']['imageDelivery'] == 'omitted'
+    else:
+        assert len(result['content']) == 1
+        assert png not in json.dumps(result)
+    assert result['structuredContent']['untrusted'] is True
+    try:
+        m.observe('files.read', {'path': 'x' * 17000})
+        raise AssertionError('oversized args accepted')
+    except m.RpcError:
+        pass
+    server.close()
+print('socket-roundtrip-and-bounds-pass')
+`;
+  const output = execFileSync('python3', ['-B', '-c', script], { encoding: 'utf8', timeout: 10000 });
+  expect(output).toContain('socket-roundtrip-and-bounds-pass');
+});
+
+it.each([false, true])('reads actual JPEG disk bytes through FileProvider and MCP image gate %s', async (images) => {
+  const { FileObservationProvider } = await import('./observation-files');
+  const { mkdtemp, writeFile, rm } = await import('node:fs/promises');
+  const { tmpdir } = await import('node:os');
+  const fixtureRoot = path.resolve('docs/verification/2026-10-06-desktop-ui/screens');
+  const provider = new FileObservationProvider({ workspaceId: 'w', environmentId: 'local', root: fixtureRoot });
+  const temp = await mkdtemp(path.join(tmpdir(), 'wsl-jpeg-mcp-'));
+  try {
+    const result = await provider.read({ path: 'real-window-workshop-overlay.jpg' });
+    expect(result.data.mediaType).toBe('image/jpeg');
+    const responsePath = path.join(temp, 'response.json');
+    await writeFile(responsePath, JSON.stringify(result));
+    const script = `
+import importlib.util,socket,threading,json
+spec=importlib.util.spec_from_file_location('m',${JSON.stringify(path.resolve('apps/service/src/resource_mcp.py'))})
+m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
+m.OBSERVATION_IMAGES=${images ? 'True' : 'False'}
+m.OBSERVATION_SOCKET=${JSON.stringify(path.join(temp, 'read.sock'))}
+with open(${JSON.stringify(responsePath)}) as f: observation=json.load(f)
+s=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM);s.bind(m.OBSERVATION_SOCKET);s.listen(1)
+def reply():
+ c,_=s.accept()
+ with c:
+  request=json.loads(c.makefile('rb').readline());assert request['tool']=='files.read'
+  c.sendall((json.dumps(observation)+'\\n').encode())
+t=threading.Thread(target=reply);t.start()
+r=m.dispatch({},'tools/call',{'name':'files_read','arguments':{'path':'real-window-workshop-overlay.jpg'}})
+t.join(2);s.close()
+images=[x for x in r['content'] if x['type']=='image']
+assert len(images)==(1 if m.OBSERVATION_IMAGES else 0)
+if images: assert images[0]['mimeType']=='image/jpeg' and images[0]['data']==observation['data']['base64']
+assert observation['data']['base64'] not in json.dumps(r['structuredContent'])
+print('actual-jpeg-gate-pass')
+`;
+    expect(execFileSync('python3', ['-B', '-c', script], { encoding: 'utf8', timeout: 10000 })).toContain('actual-jpeg-gate-pass');
+  } finally {
+    await provider.close();
+    await rm(temp, { recursive: true, force: true });
+  }
+});
