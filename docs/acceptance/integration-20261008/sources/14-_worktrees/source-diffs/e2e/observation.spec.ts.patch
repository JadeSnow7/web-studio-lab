+async function read(tool: ObservationRequest['tool'], args: Record<string, unknown> = {}): Promise<ObservationResult> {
+  return page.evaluate(({ tool, args }) => window.studio.observation.read({ workspaceId: 'taskflow-demo', tool, args }), { tool, args });
+}
+function observation(result: ObservationResult): Observation {
+  if ('error' in result) throw new Error(`${result.error}: ${result.message}`);
+  return result;
+}
+async function previewEval(code: string) {
+  return app.evaluate(
+    async ({ webContents }, { id, code }) => {
+      const wc = webContents.fromId(id);
+      if (!wc) throw new Error('Missing actual preview');
+      return wc.executeJavaScript(code);
+    },
+    { id: browserId, code },
+  );
+}
