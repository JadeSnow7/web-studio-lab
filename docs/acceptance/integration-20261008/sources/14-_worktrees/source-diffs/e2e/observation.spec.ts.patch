+// Resolve metadata only: importing Electron itself may run its lazy installer.
+async function electronExecutable(): Promise<string> {
+  try {
+    if (process.env.WSL_E2E_ELECTRON) {
+      await access(process.env.WSL_E2E_ELECTRON);
+      return process.env.WSL_E2E_ELECTRON;
+    }
+    const packagePath = createRequire(path.resolve('apps/desktop/package.json')).resolve('electron/package.json');
+    const packageRoot = path.dirname(packagePath);
+    const relative = (await readFile(path.join(packageRoot, 'path.txt'), 'utf8')).trim();
+    const executable = path.join(packageRoot, 'dist', relative);
+    await access(executable);
+    return executable;
+  } catch {
+    throw new Error('No prepared Electron executable; set WSL_E2E_ELECTRON. This acceptance test never installs Electron.');
+  }
+}
+let userData: string | undefined;
+let failed = false;
+let app: ElectronApplication;
+let page: Page;
+let filesRoot: string;
+let browserId: number;
+let nonce: string;
+const live = process.env.WSL_LIVE_OBSERVATION === '1';
+
+test.describe.configure({ mode: 'serial' });
+test.beforeAll(async () => {
+  const executablePath = await electronExecutable();
+  filesRoot = await mkdtemp(path.join(tmpdir(), 'wsl-observation-files-'));
+  userData = await mkdtemp(path.join(tmpdir(), 'wsl-observation-profile-'));
+  nonce = randomUUID();
+  await writeFile(path.join(filesRoot, 'acceptance.txt'), `disk:${nonce}\n中文 UTF-8 continuation\n`);
+  const desktop = path.resolve('apps/desktop');
+  app = await _electron.launch({
+    executablePath,
+    cwd: desktop,
+    args: [desktop, `--user-data-dir=${userData}`],
+    env: {
+      ...process.env,
+      WSL_OBSERVATION_ROOT: filesRoot,
+      WSL_SBX_NAME: live ? (process.env.WSL_SBX_NAME ?? 'wsl-sbx-smoke-20261006') : 'fixture-sandbox',
+      WSL_SBX_BIN: live ? (process.env.WSL_SBX_BIN ?? '/opt/homebrew/bin/sbx') : '/missing/no-model-in-observation-tests',
+      WSL_CODEX_BIN: '/missing/host-codex-must-not-run',
+    },
+  });
+  const workbench = (p: Page) => p.url().startsWith('file:') && p.url().endsWith('/renderer/index.html');
+  page = app.windows().find(workbench) ?? (await app.waitForEvent('window', { predicate: workbench }));
+  await page.waitForSelector('div.app');
+  browserId = await app.evaluate(({ BrowserWindow }) => {
+    const window = BrowserWindow.getAllWindows()[0];
+    if (!window) throw new Error('Missing window');
+    window.setContentSize(1440, 900);
