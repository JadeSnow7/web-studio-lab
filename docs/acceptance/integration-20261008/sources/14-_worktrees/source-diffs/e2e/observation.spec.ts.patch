+test.afterEach(async ({ browserName }, info) => {
+  void browserName;
+  if (info.status !== info.expectedStatus) {
+    failed = true;
+    await info.attach('retained-test-directories.json', {
+      body: JSON.stringify({ userData, filesRoot }),
+      contentType: 'application/json',
+    });
+  }
+});
+test.afterAll(async ({ browserName }, info) => {
+  void browserName;
+  let evidenceSaved = false;
+  try {
+    await app?.close();
+    // Only the service's immutable snapshot directory; never archive the whole profile.
+    if (userData) {
+      const directory = path.join(userData, 'chat', 'observations');
+      const entries = await readdir(directory, { withFileTypes: true }).catch((error: NodeJS.ErrnoException) => {
+        if (error.code === 'ENOENT') return [];
+        throw error;
+      });
+      const snapshots = entries.filter((entry) => entry.isFile() && /^[a-f0-9-]{36}\.json$/i.test(entry.name));
+      if (snapshots.length > 100) throw new Error('Snapshot evidence exceeds 100-file archive budget; profile retained');
+      let totalBytes = 0;
+      for (const entry of snapshots) {
+        const file = path.join(directory, entry.name);
+        const size = (await stat(file)).size;
+        totalBytes += size;
+        if (size > 2 * 1024 * 1024 || totalBytes > 16 * 1024 * 1024) {
+          throw new Error('Snapshot evidence exceeds archive byte budget; profile retained');
+        }
+        const body = await readFile(file);
+        const snapshot = ObservationSchema.parse(JSON.parse(body.toString('utf8')));
+        if (entry.name !== `${snapshot.snapshotId}.json` || snapshot.resource.workspaceId !== 'taskflow-demo') {
+          throw new Error('Snapshot identity mismatch; profile retained');
+        }
+        await info.attach(`observation-${snapshot.snapshotId}.json`, { body, contentType: 'application/json' });
+      }
+      await info.attach('observation-evidence-manifest.json', {
+        body: JSON.stringify({ files: snapshots.map((entry) => entry.name), totalBytes }),
+        contentType: 'application/json',
+      });
+    }
+    evidenceSaved = true;
+  } finally {
+    if (!failed && evidenceSaved) {
+      if (userData) await rm(userData, { recursive: true, force: true });
+      if (filesRoot) await rm(filesRoot, { recursive: true, force: true });
+    } else {
+      await info.attach('retained-test-directories.json', {
+        body: JSON.stringify({ userData, filesRoot }),
+        contentType: 'application/json',
+      });
+    }
+  }
+});
