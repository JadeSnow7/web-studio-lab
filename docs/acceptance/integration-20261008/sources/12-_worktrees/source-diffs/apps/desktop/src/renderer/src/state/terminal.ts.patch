+import type { TerminalSnapshot } from '@wsl/protocol';
+import { createStore } from '../lib/store';
+
+export interface TerminalState {
+  snapshot: TerminalSnapshot | null;
+  pending: boolean;
+  error: string | null;
+}
+export const terminalStore = createStore<TerminalState>({ snapshot: null, pending: false, error: null });
+
+export function projectTerminal(state: TerminalState, snapshot: TerminalSnapshot): TerminalState {
+  if (state.snapshot && state.snapshot.seq >= snapshot.seq) return state;
+  return { ...state, snapshot };
+}
+function receive(snapshot: TerminalSnapshot) {
+  terminalStore.set((state) => projectTerminal(state, snapshot));
+}
+async function action(run: () => Promise<void | TerminalSnapshot>) {
+  try {
+    const snapshot = await run();
+    if (snapshot) receive(snapshot);
+  } catch (error) {
+    terminalStore.set((state) => ({ ...state, error: (error as Error).message }));
+  }
+}
+async function transition(run: () => Promise<TerminalSnapshot>) {
+  if (terminalStore.get().pending) return;
+  terminalStore.set((state) => ({ ...state, pending: true, error: null }));
+  await action(run);
+  terminalStore.set((state) => ({ ...state, pending: false }));
+}
+export const terminalActions = {
+  open: (cols: number, rows: number) => transition(() => window.studio.terminal.open(cols, rows)),
+  close: (sessionId: string) => transition(() => window.studio.terminal.close(sessionId)),
+  write: (sessionId: string, data: string) => action(() => window.studio.terminal.write(sessionId, data)),
+  resize: (sessionId: string, cols: number, rows: number) => action(() => window.studio.terminal.resize(sessionId, cols, rows)),
+};
+export async function initializeTerminal() {
+  window.studio.terminal.onState(receive);
+  await action(() => window.studio.terminal.get());
+}
