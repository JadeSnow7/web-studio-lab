+import { useStore } from '../lib/store';
+import { resourcesStore } from '../state/resources';
+
+export function ResourceFeedback({ spaceId }: { spaceId: string }) {
+  const error = useStore(resourcesStore, (state) => state.errors[spaceId]);
+  const notice = useStore(resourcesStore, (state) => state.notices[spaceId]);
+  const pending = useStore(resourcesStore, (state) => state.pending[spaceId]);
+  return (
+    <div className="resource-feedback">
+      {error ? (
+        <p className="text-bad small" role="alert">
+          {error}。请检查页面或停止当前回复后重试。
+        </p>
+      ) : (
+        <p className="muted small" role="status">
+          {pending ? '正在更新空间资源…' : (notice ?? '')}
+        </p>
+      )}
+    </div>
+  );
+}
