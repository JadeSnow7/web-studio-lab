+it('forwards typed observation invalidation events without treating them as request responses', () => {
+  const service = new ChatService(
+    () => undefined,
+    () => undefined,
+  );
+  const listener = vi.fn();
+  service.setInvalidationListener(listener);
+  const hint = {
+    workspaceId: 'taskflow-demo',
+    environmentId: 'local',
+    resourceId: 'files:local',
+    generation: 'g',
+    watchGeneration: 1,
+    sequence: 1,
+    capturedAt: '2026-10-07T10:00:00.000Z',
+    change: 'change',
+    coverage: { scope: 'observed-directories', recursive: false, lossy: true },
+  };
+  mock.callbacks.get('message')?.({ type: 'observation-invalidation', hint });
+  expect(listener).toHaveBeenCalledWith(hint);
+  expect(mock.kill).not.toHaveBeenCalled();
+  service.setInvalidationListener(null);
+  mock.callbacks.get('message')?.({ type: 'observation-invalidation', hint: { ...hint, sequence: 2 } });
+  expect(listener).toHaveBeenCalledTimes(1);
+});
