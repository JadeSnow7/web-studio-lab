+function BrowserTabs() {
+  const active = useStore(shellStore, (s) => s.browserTab);
+  const pageTitle = useStore(previewStore, (p) => p?.page.title ?? '');
+  return (
+    <nav className="tabs no-drag" role="tablist" aria-label="TaskFlow 演示空间的标签">
+      {BROWSER_TABS.map(({ tab, label, icon }) => (
+        <button
+          key={tab}
+          type="button"
+          role="tab"
+          aria-selected={active === tab}
+          id={`space-tab-${tab}`}
+          aria-controls={`space-panel-${tab}`}
+          tabIndex={active === tab ? 0 : -1}
+          onKeyDown={(event) => {
+            const index = BROWSER_TABS.findIndex((item) => item.tab === tab);
+            const next =
+              event.key === 'ArrowRight'
+                ? (index + 1) % BROWSER_TABS.length
+                : event.key === 'ArrowLeft'
+                  ? (index + BROWSER_TABS.length - 1) % BROWSER_TABS.length
+                  : event.key === 'Home'
+                    ? 0
+                    : event.key === 'End'
+                      ? BROWSER_TABS.length - 1
+                      : null;
+            if (next === null) return;
+            event.preventDefault();
+            const target = BROWSER_TABS[next]!.tab;
+            shellActions.setBrowserTab(target);
+            document.getElementById(`space-tab-${target}`)?.focus();
+          }}
+          className="tab"
+          onClick={() => shellActions.setBrowserTab(tab)}
+          title={tab === 'preview' ? pageTitle : label}
+        >
+          <Icon name={icon} size={15} />
+          <span className="tab-label">{tab === 'preview' ? pageTitle || '演示页面' : label}</span>
+        </button>
+      ))}
+      <button
