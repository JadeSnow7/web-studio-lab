diff --git a/private/tmp/wsl-integration-sources/00-primary/apps/desktop/src/renderer/src/workbench/RunSection.tsx b/private/tmp/wsl-integration-sources/00-primary/apps/desktop/src/renderer/src/workbench/RunSection.tsx
