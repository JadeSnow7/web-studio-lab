diff --git a/private/tmp/wsl-integration-sources/08-eb15/apps/desktop/src/renderer/src/workspace/Workbench.tsx b/private/tmp/wsl-integration-sources/08-eb15/apps/desktop/src/renderer/src/workspace/Workbench.tsx
new file mode 100644
index 0000000..0f29cb1
