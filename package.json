{
  "name": "web-studio-lab",
  "private": true,
  "description": "Web Studio Lab：以运行页面为中心的 Electron 开发工作台（OSCHINA 开源大赛 2026 比赛版）",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:service && pnpm --filter @wsl/desktop dev",
    "build:service": "pnpm --filter @wsl/desktop exec vite build --config ../service/vite.config.ts",
    "build": "pnpm build:service && pnpm --filter @wsl/desktop build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json && pnpm typecheck:baseline",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && node --test scripts/packaging/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:e2e": "pnpm build && playwright test",
    "package": "node scripts/packaging/package-release.mjs",
    "test:e2e:packaged": "WSL_E2E_TARGET=packaged playwright test",
    "typecheck:baseline": "node node_modules/typescript-baseline/lib/tsc.js -p tsconfig.json --noEmit",
    "baseline:selftest": "tsx --test tests/vertical-slice/selftest.test.ts",
    "baseline": "tsx tests/vertical-slice/run.ts",
    "payloads:prepare": "node scripts/packaging/prepare-payloads.mjs",
    "package:unsigned": "node scripts/packaging/package-release.mjs --unsigned",
    "test:packaging": "node --test scripts/packaging/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "4.21.0",
    "typescript-baseline": "npm:typescript@5.9.3",
    "vite": "7.3.1",
    "zod": "4.3.6"
  },
  "type": "module"
}
