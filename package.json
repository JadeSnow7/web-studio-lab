{
  "name": "web-studio-lab",
  "private": true,
  "description": "Web Studio Lab：以运行页面为中心的 Electron 开发工作台（OSCHINA 开源大赛 2026 比赛版）",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:service && pnpm --filter @wsl/desktop dev",
    "build:service": "pnpm --filter @wsl/desktop exec vite build --config ../service/vite.config.ts",
    "build": "pnpm build:service && pnpm --filter @wsl/desktop build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:e2e": "pnpm build && playwright test",
    "package": "pnpm build:service && pnpm --filter @wsl/desktop package",
    "test:e2e:packaged": "WSL_E2E_TARGET=packaged playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "type": "module"
}
